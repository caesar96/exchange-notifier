<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme (Compose handles all drawing after this) -->
    <style name="Theme.ExchangeNotifier" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- Splash theme: shown at launch, hands off to base theme when ready -->
    <style name="Theme.ExchangeNotifier.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_icon_bg</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.ExchangeNotifier</item>
    </style>
</resources>
